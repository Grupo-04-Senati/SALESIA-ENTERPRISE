# ============================================================
# SalesIA Enterprise — Variables de entorno (plantilla)
# Copiar a .env y completar. NUNCA versionar el archivo .env real.
# Documentación: docs/02_arquitectura.md (sección 8)
# ============================================================

# ---------- Entorno ----------
ENVIRONMENT=development

# ---------- Backend (FastAPI / Railway) ----------
# Conexión PostgreSQL (Supabase). Usar el pooler en producción.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Firma de los tokens JWT (generar con: openssl rand -hex 32)
SECRET_KEY=cambiar-por-secreto-fuerte

# Duración del access token (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Orígenes permitidos (CORS): producción y preview de Vercel, separados por coma
CORS_ORIGINS=https://tu-app.vercel.app,https://*.vercel.app

# ---------- Frontend (React / Vercel) ----------
# URL pública de la API para el cliente HTTP.
# IMPORTANTE: en Vercel solo se exponen las variables con prefijo VITE_
VITE_API_BASE_URL=https://tu-backend.up.railway.app/api/v1

# URL de la API desde la perspectiva del backend (para links en reportes/correos)
API_BASE_URL=https://tu-backend.up.railway.app

# ---------- Supabase (opcional, según uso) ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
