# ============================================================
# SalesIA Enterprise — Variables de entorno (plantilla)
# Copiar a .env y completar. NUNCA versionar el archivo .env real.
# Documentación: docs/02_arquitectura.md §11 (variables) y §13 (Supabase)
# Seguridad: .env está en .gitignore. Verificar con: git check-ignore -v .env
# ============================================================

# ---------- Entorno ----------
# development | testing | production   (DEBUG=true está prohibido en production)
ENVIRONMENT=development
DEBUG=true

# ---------- Backend (FastAPI / Railway) ----------
# Conexión PostgreSQL (Supabase). Usar SIEMPRE el pooler, nunca la conexión directa.
# Formato: postgresql+psycopg://USUARIO:PASSWORD@HOST:5432/BD
#   USUARIO: postgres.<PROJECT_REF>
#   HOST:    aws-<region>.pooler.supabase.com
#   BD:      postgres
DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-<region>.pooler.supabase.com:5432/postgres

# Firma de los tokens JWT de la aplicación (generar con: openssl rand -hex 32).
# DEBE SER DISTINTO al SUPABASE_JWT_SECRET.
SECRET_KEY=cambiar-por-secreto-fuerte
ALGORITHM=HS256

# Duración del access token (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Orígenes permitidos (CORS): coincidencia EXACTA, separados por coma.
CORS_ORIGINS=https://tu-app.vercel.app,http://localhost:5173
# Previews de Vercel (URL con hash): expresión regular con fullmatch; vacío = desactivado.
CORS_ORIGIN_REGEX=https://tu-app-.*\.vercel\.app

# ---------- Frontend (React / Vercel) ----------
# URL pública de la API para el cliente HTTP (la lee frontend/src/services/api.ts).
# IMPORTANTE: en Vercel solo se exponen las variables con prefijo VITE_.
# El nombre debe ser EXACTAMENTE VITE_API_URL y SIN sufijo /api/v1:
# los endpoints de frontend/src/services/endpoints.ts ya incluyen /api/v1.
VITE_API_URL=https://tu-backend.up.railway.app

# URL de la API desde la perspectiva del backend (para links en reportes/correos)
API_BASE_URL=https://tu-backend.up.railway.app

# ---------- Supabase ----------
# Proyecto: ver el PROJECT_REF en el dashboard o en el payload del JWT (campo "ref").
# Documentación: docs/02_arquitectura.md §13

# URL pública del proyecto
SUPABASE_URL=https://<PROJECT_REF>.supabase.co

# Clave pública (anon). SEGURA para el navegador; respeta las políticas RLS.
SUPABASE_ANON_KEY=

# Clave privilegiada (service_role). SOLO backend. JAMÁS con prefijo VITE_ ni en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Claves nuevas del proyecto (publishable / secret) — usadas por el SDK v2.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Secret para verificar los JWT emitidos por Supabase (Auth). NO confundir con SECRET_KEY.
SUPABASE_JWT_SECRET=

# Contraseña de la base de datos (Dashboard → Settings → Database)
SUPABASE_DB_PASSWORD=
